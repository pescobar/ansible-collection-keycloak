{{ ansible_managed | comment }}
# Environment for the Keycloak + Caddy + PostgreSQL compose stack.
# Rendered by Ansible. Do not edit by hand; changes will be overwritten.

# --- Images ---
KEYCLOAK_IMAGE={{ keycloak_deploy_image }}:{{ keycloak_deploy_version }}
CADDY_IMAGE={{ keycloak_deploy_caddy_image }}:{{ keycloak_deploy_caddy_version }}
POSTGRES_IMAGE={{ keycloak_deploy_postgres_image }}:{{ keycloak_deploy_postgres_version }}

# --- Public hostname / TLS ---
KEYCLOAK_HOSTNAME={{ keycloak_deploy_hostname }}
{% if keycloak_deploy_admin_hostname | length > 0 %}
KEYCLOAK_ADMIN_HOSTNAME={{ keycloak_deploy_admin_hostname }}
{% endif %}
ACME_EMAIL={{ keycloak_deploy_acme_email }}
{% if keycloak_deploy_acme_ca | length > 0 %}
ACME_CA={{ keycloak_deploy_acme_ca }}
{% endif %}
CADDY_HTTP_PORT={{ keycloak_deploy_http_port }}
CADDY_HTTPS_PORT={{ keycloak_deploy_https_port }}

# --- Keycloak admin bootstrap ---
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_deploy_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_deploy_admin_password }}

# --- PostgreSQL ---
POSTGRES_DB={{ keycloak_deploy_db_name }}
POSTGRES_USER={{ keycloak_deploy_db_user }}
POSTGRES_PASSWORD={{ keycloak_deploy_db_password }}
