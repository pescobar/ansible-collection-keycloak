{{ ansible_managed | comment }}
# Environment for the Keycloak + Caddy + PostgreSQL compose stack.
# Rendered by Ansible. Do not edit by hand; changes will be overwritten.

# --- Images ---
KEYCLOAK_IMAGE={{ keycloak_image }}:{{ keycloak_version }}
CADDY_IMAGE={{ caddy_image }}:{{ caddy_version }}
POSTGRES_IMAGE={{ postgres_image }}:{{ postgres_version }}

# --- Public hostname / TLS ---
KEYCLOAK_HOSTNAME={{ keycloak_hostname }}
ACME_EMAIL={{ keycloak_acme_email }}
{% if keycloak_acme_ca | length > 0 %}
ACME_CA={{ keycloak_acme_ca }}
{% endif %}
CADDY_HTTP_PORT={{ keycloak_http_port }}
CADDY_HTTPS_PORT={{ keycloak_https_port }}

# --- Keycloak admin bootstrap ---
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_admin_password }}

# --- PostgreSQL ---
POSTGRES_DB={{ keycloak_db_name }}
POSTGRES_USER={{ keycloak_db_user }}
POSTGRES_PASSWORD={{ keycloak_db_password }}
